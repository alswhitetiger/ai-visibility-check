{
  "manifest_version": 3,
  "name": "가게 체크 — 현재 페이지 검사 (시험용)",
  "version": "0.1.0",
  "description": "사용자가 직접 선택한 현재 쇼핑몰 페이지에서 검사에 필요한 공개 정보를 추출합니다.",
  "permissions": ["activeTab", "scripting"],
  "action": { "default_title": "현재 페이지 검사", "default_popup": "extension/popup.html" },
  "host_permissions": ["https://ai-visibility.ai-visibility-worker.workers.dev/*"]
}
